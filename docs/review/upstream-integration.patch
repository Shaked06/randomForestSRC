+  ## Right-continuous evaluation, with survival one before the first time
+  ## and the final estimate carried forward after the last observed time.
+  idx <- findInterval(times, run$values)
+  list(time = times,
+       survival = c(1, surv)[1L + idx],
+       n.train = n)
