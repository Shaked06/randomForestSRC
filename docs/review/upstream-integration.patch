+## Run in a fresh R process after core-grow.R. On the reviewed source this
+## terminates R with a segmentation fault. Capture stderr to a log because
+## R's native crash handler prints a large traceback.
+suppressPackageStartupMessages(library(randomForestSRC))
+options(rf.cores = 1)
+args <- commandArgs(trailingOnly = TRUE)
+stopifnot(length(args) == 1L)
+f <- readRDS(args[1])
+cat("Loaded saved forest; predicting in a fresh R process\n")
+flush.console()
+p <- predict(f, newdata = data.frame(x = 0))
+stopifnot(all(is.finite(p$survival)))
+cat("Prediction completed without a native crash\n")
diff --git a/docs/review/repros/core-state-and-imputation.R b/docs/review/repros/core-state-and-imputation.R
new file mode 100644
index 0000000000000000000000000000000000000000..83ecfc989748f17b0b1862028db5446c48e7692f
--- /dev/null
+++ b/docs/review/repros/core-state-and-imputation.R
@@ -0,0 +1,28 @@
+## Rscript docs/review/repros/core-state-and-imputation.R
+## R_LIBS may select an isolated current-source installation.
+## Reports observed failures without modifying any source or saved results.
+suppressPackageStartupMessages(library(randomForestSRC))
+options(rf.cores = 1)
+
+## Case 1: growing another forest changes predictions from the original one.
+set.seed(18)
+n <- 100
+d <- data.frame(time = runif(n, 1, 10), status = rbinom(n, 1, .7), x = rnorm(n))
+L <- d$time * .8
+f <- rfsrc(Surv(time, status) ~ x, d, ntree = 5, entry.time = L,
+           save.memory = TRUE, seed = -13)
+p1 <- predict(f, newdata = d[, "x", drop = FALSE])
+g <- rfsrc(Surv(time, status) ~ x, d, ntree = 5, entry.time = rep(0, n),
+           save.memory = TRUE, seed = -13)
+p2 <- predict(f, newdata = d[, "x", drop = FALSE])
+cat("Same forest, same newdata: max prediction difference after another grow =",
+    max(abs(p1$survival - p2$survival)), "(expected 0)\n")
+
+## Case 2: exit-time imputation violates delayed entry and returns negative S.
+d <- data.frame(time = c(rep(NA_real_, 90), rep(1, 10)), status = 1, x = 1:100)
+L <- c(rep(2, 90), rep(0, 10))
+f <- rfsrc(Surv(time, status) ~ x, d, ntree = 1, bootstrap = "none",
+           nodesize = 1000, entry.time = L, na.action = "na.impute", seed = -13)
+cat("Imputed exits below entry =",
+    sum(f$imputed.data[, "time"] < L[f$imputed.indv]), "(expected 0)\n")
+cat("Returned survival range =", range(f$survival), "(expected within [0,1])\n")
diff --git a/docs/review/repros/metrics.R b/docs/review/repros/metrics.R
new file mode 100644
index 0000000000000000000000000000000000000000..d2c08e6afb9f09a08c889004c03df2ca5df3c6a9
--- /dev/null
+++ b/docs/review/repros/metrics.R
@@ -0,0 +1,73 @@
+# Run with R_LIBS_USER pointing to fresh review library, from repository root.
+suppressPackageStartupMessages(library(randomForestSRC))
+cat('Package:', find.package('randomForestSRC'),'\n')
+e <- new.env(parent=asNamespace('randomForestSRC'))
+sys.source('R/utilities_survival.R',e)
+shim <- function(time,status,entry=NULL,S=NULL,grid=sort(unique(time))) {
+ n<-length(time)
+ if(is.null(S)) S<-matrix(rep(seq(.8,.1,length.out=length(grid)),each=n),n)
+ o<-list(family='surv', yvar=cbind(time,status), predicted=rowSums(1-S),
+         survival.oob=S,predicted.oob=rowSums(1-S),time.interest=grid,
+         forest=list(yvar=cbind(time,status),xvar=data.frame(x=seq_len(n))),
+         imputed.indv=NULL,entry.time=entry)
+ class(o)<-c('rfsrc','grow','surv');o
+}
+# 1. Subsetting must not change a score when it only permutes all subjects.
+# Outcome/prediction misalignment existed before the LT work. The new entry
+# indexing retains that bug and pairs the wrong entry time with each curve.
+S<-rbind(c(.9,.8,.7,.6),c(.8,.6,.4,.2),c(.6,.4,.2,.1),c(.4,.3,.2,.1))
+o<-shim(c(1,2,3,4),c(1,1,0,1),c(0,.5,1,1.5),S)
+a<-e$get.brier.survival(o,subset=1:4,entry.time=o$entry.time)$crps
+b<-e$get.brier.survival(o,subset=4:1,entry.time=o$entry.time)$crps
+cat('Subset permutation CRPS:',a,b,'\n');stopifnot(abs(a-b)>.5)
+plain_a<-e$get.brier.survival(o,subset=1:4)$crps
+plain_b<-e$get.brier.survival(o,subset=4:1)$crps
+cat('Without LT, same inherited permutation bug:',plain_a,plain_b,'\n')
+stopifnot(abs(plain_a-plain_b)>.1)
+# 2. Allowed inclusive entry causes zero division at earliest tied event.
+o<-shim(c(1,2,3,4),rep(1,4),rep(1,4))
+b<-e$get.brier.survival(o,entry.time=o$entry.time)
+cat('Tied-entry earliest case Brier row:',b$brier.matx[1,],'\n')
+stopifnot(all(is.infinite(b$brier.matx[1,])))
+a<-e$get.auc.survival(o,entry.time=o$entry.time)
+stopifnot(is.na(a$auc$auc[1]))
+# 3. Actual predict objects cannot score different-sized LT test sets;
+# equal-sized test sets silently use training outcomes. The outcome overwrite
+# predates LT for Brier; the new shared setup propagates it to the new AUC
+# function, and the new entry validation additionally rejects test-sized L.
+set.seed(42);d<-data.frame(time=rexp(40)+1,status=rep(c(0,1),20),x=rnorm(40))
+f<-rfsrc(Surv(time,status)~x,d,ntree=10,entry.time=rep(.2,40))
+p<-predict(f,newdata=d[1:15,])
+a<-tryCatch(e$get.auc.survival(p,entry.time=rep(.2,15)),error=conditionMessage)
+cat('Test-size error:',a,'\n');stopifnot(is.character(a))
+test<-d;test$time<-test$time+100;test$status<-1-test$status
+p<-predict(f,newdata=test)
+a<-e$get.auc.survival(p,entry.time=rep(.2,40))
+stopifnot(identical(as.numeric(a$event.info$time),as.numeric(d$time)),
+          !identical(as.numeric(a$event.info$time),as.numeric(test$time)))
+cat('Equal-sized test set scored against training times: TRUE\n')
+# 4. Under independent uniform source entry/event distributions, retained
+# entry ECDF is 2*l-l^2, not source entry CDF l.
+# P(L<=x | L<T) = integral_0^x (1-l) dl / P(L<T)
+#                = (x-x^2/2)/(1/2) = 2*x-x^2.
+x <- .5
+source_cdf <- x
+selected_cdf <- (x-x^2/2)/.5
+stopifnot(source_cdf == .5, selected_cdf == .75)
+set.seed(901);N<-1000000;L<-runif(N);T<-runif(N);keep<-L<T
+est<-mean(L[keep]<=.5)
+cat('Selected F_L(.5):',est,';true source CDF:.5;selected analytic:.75\n')
+stopifnot(abs(est-.75)<.005)
+# 5. Actual LT Brier implementation scores a distorted survival curve better
+# than oracle, despite no censoring and correctly independent truncation.
+set.seed(12);N<-12000;L<-runif(N);T<-runif(N);keep<-L<T
+L<-L[keep];T<-T[keep];grid<-seq(.01,1,.01);n<-length(T)
+res<-sapply(c(1,1.3),function(alpha) {
+ S<-matrix(rep((1-grid)^alpha,each=n),nrow=n)
+ o<-shim(T,rep(1,n),L,S,grid)
+ b<-e$get.brier.survival(o,entry.time=L)
+ c(at_half=b$brier.score$brier.score[50],crps=b$crps)
+})
+colnames(res)<-c('oracle','distorted');print(res)
+stopifnot(res[1,2]<res[1,1],res[2,2]<res[2,1])
+cat('Confirmed all five metric counterexamples.\n')
diff --git a/docs/review/repros/performance-zero-entry.R b/docs/review/repros/performance-zero-entry.R
new file mode 100644
index 0000000000000000000000000000000000000000..f0630bc1192a3ee43752ef8ec28ae5e7817e3180
--- /dev/null
+++ b/docs/review/repros/performance-zero-entry.R
@@ -0,0 +1,15 @@
+## A timing illustration; elapsed-time ratios depend on the machine.
+## The exact equality check is deterministic; timing is not a regression test.
+suppressPackageStartupMessages(library(randomForestSRC))
+set.seed(42)
+n <- 10000
+time <- rexp(n)
+status <- rbinom(n, 1, .7)
+risk <- rnorm(n)
+a <- system.time(x <- get.cindex(time, status, risk))[["elapsed"]]
+b <- system.time(y <- get.cindex(time, status, risk, entry = rep(0, n)))[["elapsed"]]
+stopifnot(isTRUE(all.equal(x, y)))
+cat("Concordance with NULL entry:", a, "s; with all-zero entry:", b,
+    "s; values equal:", x, "\n")
+cat("Grow calls pass a non-NULL entry vector even when entry.time is omitted;\n",
+    "src/survivalE.c disables the Fenwick path whenever entry != NULL.\n", sep = "")
diff --git a/docs/review/repros/r-interface.R b/docs/review/repros/r-interface.R
new file mode 100644
index 0000000000000000000000000000000000000000..027e956ee655f19c2f5b1d7c671bb14501650059
--- /dev/null
+++ b/docs/review/repros/r-interface.R
@@ -0,0 +1,67 @@
+## Run from repository root, optionally selecting a library via R_LIBS:
+## R_LIBS=/path/to/review/library Rscript docs/review/repros/r-interface.R
+## These assertions characterize observed bugs; they are not desired behavior.
+suppressPackageStartupMessages(library(randomForestSRC))
+options(rf.cores = 1, mc.cores = 1)
+set.seed(6)
+n <- 120L
+d <- data.frame(time = rexp(n) + 1, status = rbinom(n, 1, .7),
+                x = rnorm(n), z = rnorm(n))
+entry <- runif(n) * d$time * .95
+message_or_ok <- function(expr) {
+  tryCatch({ force(expr); "OK" }, error = conditionMessage)
+}
+
+## BUG: default NA omission changes data rows without subsetting entry.time.
+d.na <- d
+d.na$x[2] <- NA_real_
+baseline <- rfsrc(Surv(time, status) ~ ., d.na, ntree = 10)
+na.error <- message_or_ok(rfsrc(Surv(time, status) ~ ., d.na, ntree = 10,
+                               entry.time = entry))
+stopifnot(baseline$n == n - 1L, grepl("Invalid entry.time", na.error))
+cat("BUG NA omission: ordinary fit retains", baseline$n,
+    "rows; entry-aware fit rejects the original-length entry vector.\n")
+
+## BUG: restore-mode performance and standalone VIMP silently score entry-blind.
+## Keep grow and restore in the same R process: fresh-process restoration has
+## an additional native crash covered by the C review's reproduction.
+f <- rfsrc(Surv(time, status) ~ ., d, ntree = 100, entry.time = entry,
+           use.uno = FALSE, importance = FALSE, seed = -22)
+p <- predict(f)
+v <- vimp(f, importance = "permute", seed = -33)
+blind <- get.cindex(d$time, d$status, f$predicted.oob)
+aware <- get.cindex(d$time, d$status, f$predicted.oob, entry = entry)
+grow.error <- unname(tail(f$err.rate, 1))
+restore.error <- unname(tail(p$err.rate, 1))
+vimp.error <- unname(tail(v$err.rate, 1))
+stopifnot(identical(f$predicted.oob, p$predicted.oob),
+          isTRUE(all.equal(grow.error, aware)),
+          isTRUE(all.equal(restore.error, blind)),
+          isTRUE(all.equal(vimp.error, blind)), abs(blind - aware) > 1e-4)
+cat(sprintf(paste0("BUG restored scoring: unchanged OOB predictions, ",
+                   "grow=%.7f, predict=%.7f, vimp=%.7f; ",
+                   "aware=%.7f, blind=%.7f.\n"),
+            grow.error, restore.error, vimp.error, aware, blind))
+
+## BUG: tuning holdout subsets observations but leaves entry.time unchanged.
+args <- list(formula = Surv(time, status) ~ ., data = d, sampsize = 30,
+             ntree.try = 20, nodesize.try = 5, mtry.start = 1,
+             max.iter = 1, do.best = FALSE, seed = 1)
+tune.baseline <- message_or_ok(do.call(tune, args))
+tune.entry <- message_or_ok(do.call(tune, c(args, list(entry.time = entry))))
+stopifnot(tune.baseline == "OK", grepl("Invalid entry.time", tune.entry))
+cat("BUG tuning holdout: ordinary tuning succeeds; entry-aware tuning fails length validation.\n")
+
+## BUG: unsupported split rules accept delayed entry without a guard.
+for (split in c("logrankscore", "bs.gradient")) {
+  warnings <- character()
+  fit <- withCallingHandlers(
+    rfsrc(Surv(time, status) ~ ., d, ntree = 10,
+          entry.time = entry, splitrule = split),
+    warning = function(w) {
+      warnings <<- c(warnings, conditionMessage(w))
+      invokeRestart("muffleWarning")
+    })
+  stopifnot(fit$splitrule == split, length(warnings) == 0L)
+  cat("BUG unsupported split:", split, "accepted nonzero entry.time without warning.\n")
+}
diff --git a/docs/review/repros/simulation-cox.R b/docs/review/repros/simulation-cox.R
new file mode 100644
index 0000000000000000000000000000000000000000..353f0f982fa10605fab84c191ae2b8bf3f161d00
--- /dev/null
+++ b/docs/review/repros/simulation-cox.R
@@ -0,0 +1,56 @@
+## Run from repository root. R_LIBS may select an isolated source installation.
+## This characterizes a bug; no repository data or simulation results are changed.
+suppressPackageStartupMessages(library(randomForestSRC))
+options(rf.cores = 1)
+source("simulations/_common/sim_engine.R")
+d <- data.frame(time = c(1, 2, 3, 4, 6, 8, 9, 12),
+                status = c(1, 1, 0, 1, 1, 0, 1, 0),
+                x = c(-2, 1, 0, -1, 2, 0, 1, -1))
+f <- coxph(Surv(time, status) ~ x, d)
+tg <- c(0, 1, 2, 3, 4, 6, 8, 9, 12)
+bh <- basehaz(f, centered = FALSE)
+got <- drop(cox_survival_matrix(f, matrix(0, 1, dimnames = list(NULL, "x")), tg))
+expected <- exp(-c(0, bh$hazard)[findInterval(tg, bh$time) + 1L])
+stopifnot(any(diff(got) > 0), all(diff(expected) <= 0),
+          max(abs(got - expected)) > .1)
+cat("BUG Cox grid: returned survival at t=9,12 =", tail(got, 2),
+    "; correct values =", tail(expected, 2), "\n")
+
+## Optional: quantify impact on saved runs, without fitting any forests.
+## This requires local ignored setup.rds and results_phases.rds files.
+if ("--saved" %in% commandArgs(trailingOnly = TRUE)) {
+  for (path in Sys.glob("simulations/*/setup.rds")) {
+    saved.path <- file.path(dirname(path), "results_phases.rds")
+    if (!file.exists(saved.path)) next
+    env <- new.env(parent = globalenv())
+    sys.source(file.path(dirname(path), "dgp.R"), env)
+    s <- readRDS(path)
+    saved <- readRDS(saved.path)
+    for (phase in 1:2) {
+      vals <- t(vapply(seq_len(saved$n_rep), function(r) {
+        set.seed(s$meta$master_seed + 1000L + r)
+        train <- env$sim$draw_train(s)
+        xn <- setdiff(names(train), c("entry", "time", "status"))
+        xt <- env$sim$draw_test(s, saved$m_test)
+        if (is.null(colnames(xt))) colnames(xt) <- xn
+        train$.entry <- if (phase == 1) rep(0, nrow(train)) else train$entry
+        f <- coxph(as.formula(paste("Surv(.entry,time,status)~",
+                                    paste(xn, collapse = "+"))), train)
+        old <- cox_survival_matrix(f, xt, s$time_grid)
+        bh <- basehaz(f, centered = FALSE)
+        idx <- findInterval(s$time_grid, bh$time)
+        H <- c(0, bh$hazard)[idx + 1L]
+        lp <- as.vector(xt[, names(coef(f)), drop = FALSE] %*% coef(f))
+        corrected <- exp(-outer(exp(lp), H))
+        truth <- env$sim$truth(xt, s$time_grid, s)
+        c(old = mean(abs(old - truth)), corrected = mean(abs(corrected - truth)),
+          affected = as.numeric(any(idx == 0)))
+      }, numeric(3)))
+      saved.error <- saved$overall[[paste0("p", phase, "_cox_lt")]]
+      stopifnot(max(abs(vals[, "old"] - saved.error)) < 1e-10)
+      cat(sprintf("%s phase %d: saved/reproduced MAD %.8f; corrected %.8f; affected %d/%d\n",
+                  basename(dirname(path)), phase, mean(vals[, "old"]),
+                  mean(vals[, "corrected"]), sum(vals[, "affected"]), saved$n_rep))
+    }
+  }
+}
