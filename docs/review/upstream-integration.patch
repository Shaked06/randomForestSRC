+.subsample.check.extract <- function(alpha, target, standardize, raw) {
+  if (!is.numeric(alpha) || length(alpha) != 1L || !is.finite(alpha) ||
+      alpha <= 0 || alpha >= 1) {
+    stop("'alpha' must be a finite number strictly between zero and one.",
+         call. = FALSE)
