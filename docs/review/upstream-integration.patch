+  lower <- rep(0, length(case.risk))
+  use <- lower.idx > 0L
+  lower[use] <- control.cum[lower.idx[use]]
+  same <- rep(0, length(case.risk))
+  same[equal] <- control.weight.group[idx[equal]]
