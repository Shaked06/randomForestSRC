+  }, numeric(1L))
+  case.cum <- cumsum(case.weight.group)
+  idx <- findInterval(control.risk, case.unique)
+  equal <- idx > 0L
+  equal[equal] <- case.unique[idx[equal]] == control.risk[equal]
+  leq <- rep(0, length(control.risk))
