+  ord <- order(control.risk)
+  risk <- control.risk[ord]
+  weight <- q[ord]
+  run <- rle(risk)
+  run.end <- cumsum(run$lengths)
+  run.start <- run.end - run$lengths + 1L
+  control.unique <- run$values
