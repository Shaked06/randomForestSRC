diff --git a/R/rfsrc.RNGversion.R b/R/rfsrc.RNGversion.R
new file mode 100644
index 0000000000000000000000000000000000000000..333c3c89e9a371729e6d0d204edda048dabceb26
--- /dev/null
+++ b/R/rfsrc.RNGversion.R
@@ -0,0 +1,13 @@
+rfsrc.RNGversion <- function(version) {
+  previous <- getOption("rf.rng.version")
+  if (missing(version)) {
+    current <- if (is.null(previous)) "3.10.0" else previous
+    get.rng.version.code(current)
+    return(current)
+  }
+  if (!is.null(version)) {
+    get.rng.version.code(version)
+  }
+  options(rf.rng.version = version)
+  invisible(previous)
+}
