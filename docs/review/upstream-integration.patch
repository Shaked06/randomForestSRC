+    y <- as.integer(truth)
+  }
+  scores <- .imbalanced.probability.matrix(
+    yhat, length(truth), labs, positive, clamp = FALSE)[, 2L]
+  use <- !is.na(y) & is.finite(scores)
+  list(positive = scores[use & y == 1L],
+       negative = scores[use & y == 0L])
+}
