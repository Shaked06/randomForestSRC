+.subsample.require.reference <- function(x) {
+  available <- vapply(x, function(z) {
+    !is.null(z) && NROW(z) > 0L && NCOL(z) > 0L
+  }, logical(1L))
+  if (!length(available) || !any(available)) {
+    stop("No reference VIMP or prediction-error statistics are available. ",
