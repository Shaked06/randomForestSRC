src/*.o
src/*.so
src/*.dll
src/symbols.rds
*.Rcheck/

# knitr build output (regenerable from the .Rmd source)
*_cache/
*_files/
*.html
# ...except RESULTS.Rmd, which knits to github_document (RESULTS.md) rather
# than html_document -- the .md and its plot images are meant to be checked
# in and viewed directly on GitHub, not regenerated on demand.
!RESULTS_files/

# simulation outputs (regenerable via stage0/stage1 .Rmd; package data ships
# as data/*.rda, never *.rds, so this only ever matches generated objects)
*.rds

# R session / editor cruft
.Rhistory
.RData
.Rproj.user/
.DS_Store
